#=========================================================================
# 21. iStore 软件中心 —— 本版已移除（2026-11-22）
#     原因：已用 FastNet 替代，不再需要 iStore 拖进来的 GNU tar / Lua /
#     压缩库一长串依赖（run #23 的 tar-1.35-r2.apk 编译失败就是这条链）。
#     diy-part1.sh 里 ADD_ISTORE=false，workflow 的 ISTORE_SYMS 段已整段删掉。
#     ★ FastNet 不依赖 iStore：fastnet / luci-app-fastnet /
#       linkease-app-entry / luci-lib-linkeaseauth 四行在下方「定制增强」段，
#       全部保留，照常使用。装包仍可用 luci-app-package-manager（apk 界面）。
#     ★ 上方 6 行 CONFIG_PACKAGE_TAR_* 是上游基座的 tar 内部特性开关，
#       PACKAGE_tar 未选中时它们不可见，不会触发任何包编译，保持原样。
#=========================================================================
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-lib-taskd is not set
# CONFIG_PACKAGE_luci-lib-xterm is not set
# CONFIG_PACKAGE_taskd is not set

# curl 保留：DDNS(花生壳) / PassWall / FastNet / Homebox 等插件会用到
CONFIG_PACKAGE_curl=y                              # 通用 HTTP 客户端（非 iStore 专属）

# ==========================================================
# 定制增强（AN758X_定制增强包 / 2026-11-22）
#   PassWall + FastNet + 花生壳 DDNS（SmartDNS 已移除）；关闭 IPv6
#   与 diy-part1.sh 的 clone 段、上方 # ... is not set 一一对应
#   ★ profile=<机型> 时只读本文件，configs/<SoC>.config 不参与
# ==========================================================
CONFIG_PACKAGE_xray-core=y                       # PassWall 主力内核（feeds 自带）
CONFIG_PACKAGE_sing-box=y                       # PassWall 备用内核（feeds 自带）
# ---------------------------------------------------------------------
# ★ DDNS 只留花生壳（2026-11-23 用户「DDNS 只要花生壳的这个，其他的都得剔除」）
#   保留：ddns-scripts（引擎）+ luci-app-ddns（界面）+ 中文包
#         + ddns-scripts-services（provider 列表，oray.com.json 在这里面）
#   剔除：Lucky 整组（另一个 DDNS 客户端，见下方「Lucky 整组已移除」段）
#   剔除：其余 93 个服务商 —— 由 files/etc/uci-defaults/99-zz-ddns-only-oray
#         在首次开机删掉 /usr/share/ddns/default/ 下除 oray.com.json 外的
#         所有 .json，LuCI 服务商下拉就只剩 `oray.com`（+ 一个 custom 选项）。
#
#   ⚠ ddns-scripts-services **不能整个删**：ddns-scripts 的 Makefile 里
#     DEPENDS:=+ddns-scripts-services +resolveip +ip 是硬依赖，
#     只写 =y 不装会被 defconfig 自动拉回；94 个 json 也随包一起编入。
#     所以采用「运行期只留 oray.com.json」的方式，而不是改包。
#     代价：apk 的文件清单里仍列着那 93 个文件，apk --check 会报缺失，
#     但普通使用 / LuCI / ddns 服务完全不受影响。
#
#   出厂 /etc/config/ddns 只有一条 disabled 的 `config service 'oray'`，
#   填 Oray 账号 / 密码 + 花生壳免费域名（xxx.oray.net）后改 enabled=1 即用。
#   ⚠ 字段名必须是 `oray.com`（不是 `oray`）。
# ---------------------------------------------------------------------
CONFIG_PACKAGE_ddns-scripts=y                       # DDNS 引擎（官方 packages feed）
CONFIG_PACKAGE_ddns-scripts-services=y               # ★ 硬依赖：oray.com.json 在这个包里
CONFIG_PACKAGE_luci-app-ddns=y                       # DDNS LuCI 界面（官方 luci feed）
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y                       # DDNS 中文
# ---------------------------------------------------------------------
# ★ 系统 DNS 已剔除（2026-11-23，用户「剔除系统 dns 只要 passwall」）
#   SmartDNS 本体 / LuCI 前端 / 中文包 3 个全部退出；
#   files/etc/config/smartdns 与 99-zz-smartdns 也一并删除。
#   DNS 由 PassWall 独占：dns_shunt=chinadns-ng + dns_redirect=1，
#   53 由 PassWall 的 dnsmasq 实例接管，国内外智能分流。
#   ⚠ dnsmasq-full **必须保留**：LAN 的 DHCP 靠它，PassWall 的 LUCI_DEPENDS
#     里也硬写了 +dnsmasq-full（会 copy 出第二个实例）。删了固件会编坏。
# ---------------------------------------------------------------------
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set   # ★ PassWall 可选依赖默认 y，日志里仍装了 smartdns；DNS 分流用 chinadns-ng，显式关掉
# CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn is not set

# PassWall DNS 分流所需（其 LUCI_DEPENDS 本来就带 +chinadns-ng +dns2socks，
# 这里显式写 =y 防止 defconfig 静默剔除；上一版误判为「没编」）
CONFIG_PACKAGE_chinadns-ng=y                       # ChinaDNS-NG：国内/国外 DNS 分流
CONFIG_PACKAGE_dns2socks=y                          # PassWall dns_mode=dns2socks 可选
CONFIG_PACKAGE_fastnet=y                       # FastNet 本体（diy-part1.sh clone）
CONFIG_PACKAGE_luci-app-fastnet=y                       # FastNet LuCI 界面
CONFIG_PACKAGE_linkease-app-entry=y                       # FastNet 运行时入口依赖
CONFIG_PACKAGE_luci-lib-linkeaseauth=y                       # FastNet 认证库依赖
CONFIG_PACKAGE_nft-qos=y                       # ★ NFT-QoS 本体（官方 packages feed）
CONFIG_PACKAGE_luci-app-nft-qos=y              # ★ NFT-QoS LuCI 界面（官方 luci feed）
CONFIG_PACKAGE_luci-i18n-nft-qos-zh-cn=y       # ★ NFT-QoS 中文
CONFIG_PACKAGE_nftables=y                      # NFT-QoS 依赖：nftables 用户态
CONFIG_PACKAGE_kmod-nft-netdev=y               # NFT-QoS 依赖：netdev 限速
# ---------------------------------------------------------------------
# ★ 插件去重（2026-11-23）：测速/链路质量只保留 FastNet
#   FastNet（LinEase/iStoreOS 生态）= WAN 链路质量 / 网速测试，用户明确点名要。
#   Homebox = 浏览器测「客户端 ↔ 路由器」内网吞吐（:3300），预编译二进制，
#             与 FastNet 同属「测速工具」且需额外 config/init.d/uci-defaults
#             三件套维护（之前因同步上游丢过、报过 not running）→ 整组移除。
#   ✅ 2026-11-24 已按用户要求恢复：三行 =y、ADD_HOMEBOX=true、
#     files/ 三件套（config / init.d / uci-defaults）、现机救急脚本、
#     workflow 三件套硬校验、Release 插件表全部回位。
#   ⚠ iperf3 / libiperf3 是命令行诊断工具（非 LuCI 插件），保留。
#   ⚠ 想再移除：三行 is not set + ADD_HOMEBOX=false + 删 files 三件套（去重校验会自动放行）。
# ---------------------------------------------------------------------
CONFIG_PACKAGE_homebox=y                            # 内网测速本体（预编译 musl 二进制 v1.0.1）
CONFIG_PACKAGE_luci-app-homebox=y                   # LuCI 界面，:3300
CONFIG_PACKAGE_luci-i18n-homebox-zh-cn=y            # 中文包

CONFIG_PACKAGE_luci-app-vantage=y               # ★ Vantage 实时仪表盘（一般插件，非主题）
CONFIG_PACKAGE_luci-i18n-vantage-zh-cn=y        # ★ Vantage 简体中文（上游 po/zh_Hans/vantage.po）
CONFIG_PACKAGE_ucode-mod-rtnl=y                 # Vantage 依赖：桥 FDB / 默认路由
CONFIG_PACKAGE_ucode-mod-nl80211=y              # Vantage 依赖：信道 survey 噪声底

# ===== 本轮新增插件（ttyd / 看门狗 / 定时任务 / 上网控制）======
# ? 「上网控制」用的是 luci-app-accesscontrol-plus：原版 luci-app-accesscontrol
#    是 fw3/iptables 老包，在 Linux 6.18 + fw4(nftables) 上规则不生效，故不编入。
# ? 重复/相似插件对照见 固件说明.md「重复、类似的插件」章节：
#    Lucky / Homebox 已按「插件去重」移除；igmpproxy 按用户要求保留；
#    taskplan（定时任务）与 watchdog（登录失败拉黑）职责不同，**不重复**，两者都保留；
#    accesscontrol-plus / nft-qos 都属「客户端上网管控」但机制不同。
# ? 按用户要求「有风险的就要不了」，OAF（含 kmod-oaf 外部内核模块、6.18 未验证）
#    已整组移除：不 clone、不编入、不进 REQUIRED。diy-part1.sh 里 ADD_OAF=false。
CONFIG_PACKAGE_ttyd=y                             # ★ 网页终端本体（官方 packages feed）
CONFIG_PACKAGE_luci-app-ttyd=y                    # ★ 网页终端 LuCI 菜单
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y             # ★ 网页终端简体中文
# ---------------------------------------------------------------------
# ★ Lucky 整组已移除（2026-11-23）
#   它是另一个 DDNS 客户端（ddns-go 风格）+ socat 端口转发 + HTTP 反代，
#   与「DDNS 只留花生壳」冲突。三个包全部退出：
#     luci-app-lucky / lucky / luci-i18n-lucky-zh-cn
#   diy-part1.sh 里 ADD_LUCKY=false，不再 clone sirpdboy/luci-app-lucky。
#   ⚠ 连带失去：Lucky 的 socat 端口转发、HTTP 反向代理、IPv6→IPv4 转发。
#     想要回来：把下面三行改回 =y + diy 里 ADD_LUCKY=true 即可（可逆）。
# ---------------------------------------------------------------------
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_lucky is not set
# CONFIG_PACKAGE_luci-i18n-lucky-zh-cn is not set
CONFIG_PACKAGE_luci-app-watchdog=y                # ★ 看门狗（断网/进程守护自动重启）
CONFIG_PACKAGE_watchdog=y                         # 看门服务本体
CONFIG_PACKAGE_luci-i18n-watchdog-zh-cn=y         # ★ 看门狗简体中文
CONFIG_PACKAGE_luci-app-taskplan=y                # ★ 定时任务 / 开机任务 / 自定义脚本
CONFIG_PACKAGE_bash=y                             # taskplan 依赖：bash
CONFIG_PACKAGE_luci-i18n-taskplan-zh-cn=y         # ★ 定时任务简体中文
CONFIG_PACKAGE_luci-app-accesscontrol-plus=y      # ★ 上网时间控制 Plus（fw4/nftables 版，替代老 accesscontrol）
CONFIG_PACKAGE_snmpd-nossl=y                      # accesscontrol-plus 依赖（net-snmp 提供的包名）
CONFIG_PACKAGE_luci-i18n-accesscontrol-plus-zh-cn=y # ★ 上网时间控制简体中文
