#!/bin/sh /etc/rc.common
# Homebox 内网测速服务 —— procd 管理，默认自启 :3300
# ---------------------------------------------------------------------------
# 2026-11-24 恢复。之前报 "The Homebox service is not running" 的根因：
#   v1.0.1 是 Rust 版，启动必须带 `serve` 子命令：
#       homebox serve --host 0.0.0.0 --port 3300
#   老 init 裸跑 /usr/bin/homebox 只会打印帮助立刻退出 → procd 反复
#   respawn → pidof homebox 永远为空 → LuCI 红字。
# 这里用 `--help` 探测是否支持 serve，自适应新旧二进制。
# 端口固定 3300：luci-app-homebox 的 homebox_status() 把端口写死了，
# 改了页面按钮会指错。
#
# ⚠ 顶层只放变量与函数定义，不执行任何命令 —— OpenWrt 用 apk，
#   package/install 装配 rootfs 时会以普通 sh 跑一遍包内 init.d 顶层
#   （taskplan 就曾因顶层写 /etc 导致整轮编译失败）。
# ---------------------------------------------------------------------------

START=99
STOP=10
USE_PROCD=1

BIN="/usr/bin/homebox"

start_service() {
	[ -x "$BIN" ] || return 0

	config_load homebox
	local enabled port
	config_get enabled homebox enabled '0'
	config_get port homebox port '3300'
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	if "$BIN" --help 2>&1 | grep -q 'serve'; then
		# v1.0.1+ Rust 版：必须带 serve 子命令
		procd_set_param command "$BIN" serve --host 0.0.0.0 --port "$port"
	else
		# 老版：裸跑即可
		procd_set_param command "$BIN" --host 0.0.0.0 --port "$port"
	fi
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger homebox
}
